{
 "title": "FlowGate",
 "uid": "flowgate",
 "schemaVersion": 39,
 "time": {
  "from": "now-30m",
  "to": "now"
 },
 "refresh": "10s",
 "panels": [
  {
   "id": 1,
   "title": "Cost by tenant (USD/h)",
   "type": "timeseries",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 0,
    "y": 0
   },
   "targets": [
    {
     "expr": "sum by (tenant) (rate(flowgate_cost_usd_total[5m])) * 3600",
     "refId": "A",
     "legendFormat": "__auto"
    }
   ]
  },
  {
   "id": 2,
   "title": "Tokens/s by tenant and direction",
   "type": "timeseries",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 12,
    "y": 0
   },
   "targets": [
    {
     "expr": "sum by (tenant, direction) (rate(flowgate_tokens_total[1m]))",
     "refId": "A",
     "legendFormat": "__auto"
    }
   ]
  },
  {
   "id": 3,
   "title": "Requests/s by status",
   "type": "timeseries",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 0,
    "y": 8
   },
   "targets": [
    {
     "expr": "sum by (status) (rate(flowgate_requests_total[1m]))",
     "refId": "A",
     "legendFormat": "__auto"
    }
   ]
  },
  {
   "id": 4,
   "title": "Rejections/s by reason",
   "type": "timeseries",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 12,
    "y": 8
   },
   "targets": [
    {
     "expr": "sum by (reason) (rate(flowgate_rejections_total[1m]))",
     "refId": "A",
     "legendFormat": "__auto"
    }
   ]
  },
  {
   "id": 5,
   "title": "Admission latency p99 (ms)",
   "type": "timeseries",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 0,
    "y": 16
   },
   "targets": [
    {
     "expr": "histogram_quantile(0.99, sum by (le) (rate(flowgate_admission_seconds_bucket[1m]))) * 1000",
     "refId": "A",
     "legendFormat": "__auto"
    }
   ]
  },
  {
   "id": 6,
   "title": "Upstream errors/s",
   "type": "timeseries",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 12,
    "y": 16
   },
   "targets": [
    {
     "expr": "sum by (upstream, kind) (rate(flowgate_upstream_errors_total[1m]))",
     "refId": "A",
     "legendFormat": "__auto"
    }
   ]
  },
  {
   "id": 7,
   "title": "Fallbacks/s",
   "type": "timeseries",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 0,
    "y": 24
   },
   "targets": [
    {
     "expr": "sum by (route, upstream) (rate(flowgate_fallbacks_total[1m]))",
     "refId": "A",
     "legendFormat": "__auto"
    }
   ]
  },
  {
   "id": 8,
   "title": "Truncations/s",
   "type": "timeseries",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 12,
    "y": 24
   },
   "targets": [
    {
     "expr": "sum by (tenant) (rate(flowgate_truncations_total[1m]))",
     "refId": "A",
     "legendFormat": "__auto"
    }
   ]
  }
 ]
}